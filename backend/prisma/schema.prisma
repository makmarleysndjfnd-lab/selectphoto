generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  cnpj      String?  @unique
  isActive  Boolean  @default(true)
  planLimit Int      @default(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  teams                Team[]
  clients              Client[]
  cars                 Car[]
  commercialEvents     CommercialEvent[]
  costs                Cost[]
  sales                Sale[]
  nonSales             NonSale[]
  sellerPhotos         SellerPhoto[]
  coverStockBatches    CoverStockBatch[]
  sellerCoverTransfers SellerCoverTransfer[]
  bookBatches          BookBatch[]
  notifications        Notification[]
  clientEditRequests   ClientEditRequest[]
  tripSettings         TripSettings?
  sellerCityClosings   SellerCityClosing[]
  creditAgreements            CreditAgreement[]
  creditPayments              CreditPayment[]
  creditCommissions           CreditCommission[]
  creditCommissionAdjustments CreditCommissionAdjustment[]
  asaasConfig                 AsaasConfig?
  asaasCharges                AsaasCharge[]
  asaasSyncQueues             AsaasSyncQueue[]
  asaasDuplicateAlerts        AsaasDuplicatePaymentAlert[]
  monthlyCreditClosings       MonthlyCreditClosing[]
  accountDeletionRequests     AccountDeletionRequest[]
}

model Team {
  id        String   @id @default(uuid())
  name      String
  prefix    String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  type      String   @default("SALES")
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  clients   Client[]
  costs     Cost[]
  users     User[]
}

model User {
  id                      String                         @id @default(uuid())
  name                    String
  email                   String?                        @unique
  password                String
  role                    String                         @default("OPERATOR")
  active                  Boolean                        @default(true)
  teamId                  String?
  companyId               String?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  address                 String?
  cpf                     String?                        @unique
  criminalRecordUrl       String?
  emergencyPhone          String?
  isTeamLeader            Boolean                        @default(false)
  phone                   String?
  profilePhotoUrl         String?
  rg                      String?
  usesOwnCar              Boolean                        @default(false)
  photographerCode        String?
  personalAppointments    PersonalAppointment[]
  salesType               String?
  company                 Company?                       @relation(fields: [companyId], references: [id])
  appointments            Appointment[]
  currentCars             Car[]                          @relation("CarCurrentUser")
  carChecklists           CarChecklist[]
  clients                 Client[]
  assignedClients         Client[]                       @relation("AssignedSeller")
  costs                   Cost[]
  nonSales                NonSale[]
  sales                   Sale[]
  sellerPhotos            SellerPhoto[]
  team                    Team?                          @relation(fields: [teamId], references: [id])
  photographerBookBatches BookBatch[]                    @relation("PhotographerBookBatches")
  coverTransfersSent      SellerCoverTransfer[]          @relation("CoverTransfersSent")
  coverTransfersReceived  SellerCoverTransfer[]          @relation("CoverTransfersReceived")
  coverBalance            SellerCoverBalance?
  dailyClosings           DailyClosing[]
  fcmToken                String?
  pixKey                  String?
  notificationsSent       Notification[]                 @relation("NotificationsSent")
  notificationsReceived   Notification[]                 @relation("NotificationsReceived")
  clientEditRequests      ClientEditRequest[]
  sellerCityClosings      SellerCityClosing[]
  creditAgreementsSeller  CreditAgreement[]              @relation("CreditAgreementSeller")
  creditPaymentsReceived  CreditPayment[]                @relation("CreditPaymentReceiver")
  creditPaymentsReversed  CreditPayment[]                @relation("CreditPaymentReverser")
  creditCommissions           CreditCommission[]             @relation("CreditCommissionSeller")
  creditCommissionAdjustments CreditCommissionAdjustment[]   @relation("CreditCommissionAdjustmentSeller")
  creditRenegotiations        CreditAgreementRenegotiation[] @relation("CreditRenegotiationAuthor")
  monthlyCreditClosingsSeller MonthlyCreditClosing[]         @relation("MonthlyClosingSeller")
  monthlyCreditClosingsClosed MonthlyCreditClosing[]         @relation("MonthlyClosingCloser")
  monthlyClosingPayoutsAuthor MonthlyCreditClosingPayout[]   @relation("MonthlyClosingPayoutAuthor")
  accountDeletionRequests     AccountDeletionRequest[]       @relation("UserDeletionRequests")
  processedDeletionRequests   AccountDeletionRequest[]       @relation("ProcessedDeletionRequests")
}

model Client {
  id                   String    @id @default(uuid())
  uuid                 String    @unique @default(uuid())
  visibleCode          String?   @unique
  sequenceNumber       String
  createdAt            DateTime  @default(now())
  name                 String
  cep                  String?
  street               String?
  number               String?
  complement           String?
  block                String?
  apartment            String?
  neighborhood         String?
  city                 String?
  state                String?
  phone1               String?
  phone2               String?
  mainContact          String?
  event                String?
  eventDate            DateTime?
  eventTime            String?
  visitDate            DateTime?
  visitTime            String?
  condo                String?
  houseColor           String?
  gateColor            String?
  gateObservation      String?
  referencePoint       String?
  profession           String?
  clothesColor         String?
  latitude             Float?
  longitude            Float?
  status               String    @default("PENDING")
  bookStatus           String    @default("CREATED") // CREATED, AWAITING_RELEASE, IN_STOCK, DISTRIBUTED, SOLD, AWAITING_RETURN, IN_STOCK_REBOLO, DISTRIBUTED_REBOLO, REBOLO_SOLD, DISCARDED
  outcomeStatus        String    @default("PENDING") // PENDING, NON_SALE, SOLD
  outcomeUpdatedAt     DateTime?
  cityClosedAt         DateTime?
  photographerClosedAt DateTime?
  batchId              String?
  releasedForRouting   Boolean   @default(false)
  photographerId       String?
  teamId               String?
  companyId            String?
  signatureUrl         String?
  assignedSellerId     String?
  localId              String?
  commercialCycle      Int       @default(1)

  company          Company?            @relation(fields: [companyId], references: [id])
  batch            BookBatch?          @relation(fields: [batchId], references: [id])
  appointments     Appointment[]
  children         Child[]
  photographer     User?               @relation(fields: [photographerId], references: [id])
  assignedSeller   User?               @relation("AssignedSeller", fields: [assignedSellerId], references: [id])
  team             Team?               @relation(fields: [teamId], references: [id])
  evaluation       Evaluation?
  nonSales         NonSale[]
  sales            Sale[]
  sellerPhotos     SellerPhoto[]
  editRequests     ClientEditRequest[]
  timeline         ClientTimeline[]
  creditAgreements CreditAgreement[]

  @@index([companyId, assignedSellerId, city])
  @@index([outcomeStatus])
  @@index([cityClosedAt])
  @@index([photographerClosedAt])
  @@index([localId])
  @@index([sequenceNumber])
}

model FichaCodeSequence {
  id        Int      @id @default(1)
  nextValue BigInt   @default(0)
  updatedAt DateTime @updatedAt
}

model ClientTimeline {
  id               String   @id @default(uuid())
  clientId         String
  cycle            Int      @default(1)
  previousStatus   String?
  newStatus        String
  previousSellerId String?
  newSellerId      String?
  authorId         String?
  authorRole       String?
  action           String
  reason           String?
  metadata         Json?
  timestamp        DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, timestamp])
}

model Child {
  id       String @id @default(uuid())
  name     String
  age      Int
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Appointment {
  id            String   @id @default(uuid())
  date          DateTime
  time          String
  observation   String?
  status        String   @default("SCHEDULED")
  clientId      String
  responsibleId String?
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  responsible   User?    @relation(fields: [responsibleId], references: [id])
}

model Sale {
  id            String   @id @default(uuid())
  value         Float
  city          String
  date          DateTime @default(now())
  sellerId      String
  clientId      String
  companyId     String?
  paymentMethod String   @default("CASH")
  fichaNumber   String?
  paymentStatus String   @default("PAID")
  product       String   @default("Books")
  status        String   @default("PRONTO")
  hasCover      Boolean  @default(true)
  receiptUrl    String?
  sheetPhotoUrl String?
  reportNotes   String?
  isLegacy      Boolean  @default(false)

  sellerRating       Int?
  photographerRating Int?
  contactRating      Int?
  company            Company?         @relation(fields: [companyId], references: [id])
  client             Client           @relation(fields: [clientId], references: [id])
  seller             User             @relation(fields: [sellerId], references: [id])
  supersededNonSales NonSale[]        @relation("SupersededNonSales")
  payments           SalePayment[]
  creditAgreement    CreditAgreement?
}

model SalePayment {
  id         String   @id @default(uuid())
  saleId     String
  method     String // CASH, PIX, CREDIT, DEBIT
  amount     Float
  receiptUrl String?
  createdAt  DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model NonSale {
  id                 String    @id @default(uuid())
  reason             String
  date               DateTime  @default(now())
  sellerId           String
  clientId           String
  companyId          String?
  signatureUrl       String?
  sellerRating       Int?
  photographerRating Int?
  contactRating      Int?
  cycle              Int       @default(1)
  supersededAt       DateTime?
  supersededBySaleId String?

  company          Company? @relation(fields: [companyId], references: [id])
  client           Client   @relation(fields: [clientId], references: [id])
  seller           User     @relation(fields: [sellerId], references: [id])
  supersededBySale Sale?    @relation("SupersededNonSales", fields: [supersededBySaleId], references: [id])
}

model SellerPhoto {
  id        String   @id @default(uuid())
  photoPath String
  createdAt DateTime @default(now())
  expiresAt DateTime
  sellerId  String
  clientId  String
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  client    Client   @relation(fields: [clientId], references: [id])
  seller    User     @relation(fields: [sellerId], references: [id])
}

model Evaluation {
  id                String   @id @default(uuid())
  photographerStars Int
  sellerStars       Int
  createdAt         DateTime @default(now())
  clientId          String   @unique
  client            Client   @relation(fields: [clientId], references: [id])
}

model Car {
  id                 String         @id @default(uuid())
  plate              String         @unique
  model              String
  trackerLink        String?
  status             String         @default("AVAILABLE")
  createdAt          DateTime       @default(now())
  currentUserId      String?
  companyId          String?
  currentKm          Int            @default(0)
  nextOilChangeKm    Int            @default(0)
  pendingMaintenance String?
  warrantyParts      String?
  photoUrl           String?
  initialChecklist   String?
  frontPhotoUrl      String?
  backPhotoUrl       String?
  leftPhotoUrl       String?
  rightPhotoUrl      String?
  dashboardPhotoUrl  String?
  enginePhotoUrl     String?
  trunkPhotoUrl      String?
  company            Company?       @relation(fields: [companyId], references: [id])
  currentUser        User?          @relation("CarCurrentUser", fields: [currentUserId], references: [id])
  checklists         CarChecklist[]
  costs              Cost[]
}

model CarChecklist {
  id                String   @id @default(uuid())
  type              String   @default("CHECKOUT") // CHECKOUT (Saída) or CHECKIN (Entrada)
  mileage           Int
  date              DateTime @default(now())
  carId             String
  driverId          String
  backPhotoUrl      String?
  damageReport      String?
  dashboardPhotoUrl String?
  frontPhotoUrl     String?
  fuelLevel         String
  leftPhotoUrl      String?
  rightPhotoUrl     String?
  enginePhotoUrl    String?
  trunkPhotoUrl     String?
  signatureUrl      String?
  car               Car      @relation(fields: [carId], references: [id])
  driver            User     @relation(fields: [driverId], references: [id])
}

model Cost {
  id            String           @id @default(uuid())
  amount        Float
  category      String
  description   String
  date          DateTime         @default(now())
  userId        String
  paymentMethod String           @default("CASH")
  receiptUrl    String?
  status        String           @default("PENDING")
  teamId        String?
  eventId       String?
  carId         String?
  companyId     String?
  subcategory   String?
  company       Company?         @relation(fields: [companyId], references: [id])
  car           Car?             @relation(fields: [carId], references: [id])
  event         CommercialEvent? @relation(fields: [eventId], references: [id])
  team          Team?            @relation(fields: [teamId], references: [id])
  user          User             @relation(fields: [userId], references: [id])
}

model CommercialEvent {
  id                    String    @id @default(uuid())
  name                  String
  city                  String
  category              String
  score                 String
  audience              String?
  organizerContact      String?
  socialMedia           String?
  notes                 String?
  isFavorite            Boolean   @default(false)
  isProspect            Boolean   @default(true)
  createdAt             DateTime  @default(now())
  startDate             DateTime?
  endDate               DateTime?
  durationDays          Int?
  isItinerant           Boolean   @default(false)
  venueType             String?
  ticketPrice           String?
  observations          String?
  expectedRevenue       Float?    @default(0)
  estimatedFichasPerDay Int?
  estimatedTicketValue  Float?
  estimatedSpaceCost    Float?
  estimatedTeamSize     Int?      @default(2)
  distanceFromBaseKm    Float?
  roiApproved           Boolean   @default(false)
  roiApprovedAt         DateTime?
  cityAge               String?
  cityIncome            String?
  cityPerCapita         String?
  cityEconomy           String?
  companyId             String?
  company               Company?  @relation(fields: [companyId], references: [id])
  costs                 Cost[]
}

model TripSettings {
  id              String  @id @default(uuid())
  companyId       String  @unique
  costPerKm       Float   @default(0.60)
  hotelCostPerDay Float   @default(70.0)
  foodCostPerDay  Float   @default(50.0)
  productCostUnit Float   @default(21.0)
  baseCityName    String  @default("Goiânia")
  company         Company @relation(fields: [companyId], references: [id])
}

model CoverStockBatch {
  id        String   @id @default(uuid())
  quantity  Int
  entryDate DateTime @default(now())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
}

model SellerCoverTransfer {
  id        String   @id @default(uuid())
  sellerId  String
  adminId   String
  quantity  Int
  date      DateTime @default(now())
  companyId String?
  seller    User     @relation("CoverTransfersReceived", fields: [sellerId], references: [id])
  admin     User     @relation("CoverTransfersSent", fields: [adminId], references: [id])
  company   Company? @relation(fields: [companyId], references: [id])
}

model SellerCoverBalance {
  id       String @id @default(uuid())
  sellerId String @unique
  balance  Int    @default(0)
  seller   User   @relation(fields: [sellerId], references: [id])
}

model DailyClosing {
  id              String   @id @default(uuid())
  date            DateTime @default(now())
  sellerId        String
  totalSalesValue Float
  cashValue       Float
  pixValue        Float
  debitValue      Float
  creditValue     Float
  commission      Float
  repasseDebt     Float
  closingType     String   @default("SALES")
  seller          User     @relation(fields: [sellerId], references: [id])
}

model BookBatch {
  id             String   @id @default(uuid())
  name           String
  date           DateTime @default(now())
  photographerId String
  companyId      String?
  status         String   @default("CREATED") // CREATED, DISTRIBUTED
  photographer   User     @relation("PhotographerBookBatches", fields: [photographerId], references: [id])
  company        Company? @relation(fields: [companyId], references: [id])
  clients        Client[]
}

model StateRadarCache {
  id        String   @id @default(uuid())
  state     String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

model Notification {
  id         String   @id @default(uuid())
  title      String
  message    String
  type       String // STOCK_TRANSFER_COVER, STOCK_TRANSFER_BOOK, COST_APPROVAL, CLOSING_APPROVAL, FLEET_URGENT, SYSTEM
  status     String   @default("UNREAD") // UNREAD, READ, RESOLVED
  actionData Json?
  createdAt  DateTime @default(now())

  senderId    String?
  recipientId String
  companyId   String?

  sender    User?    @relation("NotificationsSent", fields: [senderId], references: [id])
  recipient User     @relation("NotificationsReceived", fields: [recipientId], references: [id])
  company   Company? @relation(fields: [companyId], references: [id])
}

model ClientEditRequest {
  id             String   @id @default(uuid())
  clientId       String
  photographerId String?
  companyId      String?
  proposedData   Json
  reason         String?
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  photographer User?    @relation(fields: [photographerId], references: [id])
  company      Company? @relation(fields: [companyId], references: [id])
}

model PersonalAppointment {
  id          String   @id @default(uuid())
  sellerId    String
  title       String
  description String?
  dateTime    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, dateTime])
}

model SellerCityClosing {
  id              String   @id @default(uuid())
  companyId       String
  sellerId        String
  city            String
  event           String?
  closedAt        DateTime @default(now())
  pendingCount    Int
  nonSaleCount    Int
  soldCount       Int
  totalSalesValue Float

  company Company @relation(fields: [companyId], references: [id])
  seller  User    @relation(fields: [sellerId], references: [id])

  @@index([companyId, sellerId, city])
  @@index([closedAt])
}

model CreditAgreement {
  id                        String   @id @default(uuid())
  saleId                    String   @unique
  clientId                  String
  sellerId                  String
  companyId                 String
  buyerName                 String
  buyerCpf                  String
  buyerRg                   String?
  street                    String
  number                    String
  neighborhood              String
  city                      String
  state                     String
  cep                       String?
  referencePoint            String?
  product                   String   @default("Books")
  totalSaleCents            Int
  downPaymentCents          Int
  financedPrincipalCents    Int
  remainingPrincipalCents   Int
  paidPrincipalCents        Int      @default(0)
  installmentsCount         Int
  periodicity               String   @default("MONTHLY")
  firstDueDate              DateTime
  status                    String   @default("ACTIVE")
  initialCommissionRate     Float    @default(0.25)
  installmentCommissionRate Float    @default(0.10)
  signedAgreementUrl        String?
  notes                     String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  sale           Sale                           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  client         Client                         @relation(fields: [clientId], references: [id])
  seller         User                           @relation("CreditAgreementSeller", fields: [sellerId], references: [id])
  company        Company                        @relation(fields: [companyId], references: [id])
  installments          CreditInstallment[]
  payments              CreditPayment[]
  commissions           CreditCommission[]
  renegotiations        CreditAgreementRenegotiation[]
  commissionAdjustments CreditCommissionAdjustment[]
  asaasCharges          AsaasCharge[]
  asaasDuplicateAlerts  AsaasDuplicatePaymentAlert[]

  @@index([companyId, sellerId])
  @@index([companyId, status])
  @@index([clientId])
}

model CreditInstallment {
  id                String    @id @default(uuid())
  agreementId       String
  installmentNumber Int
  dueDate           DateTime
  amountCents       Int
  paidCents         Int       @default(0)
  status            String    @default("PENDING")
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  agreement            CreditAgreement              @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  allocations          CreditPaymentAllocation[]
  asaasCharge          AsaasCharge?
  asaasDuplicateAlerts AsaasDuplicatePaymentAlert[]

  @@index([agreementId, dueDate])
  @@index([status])
}

model CreditPayment {
  id               String    @id @default(uuid())
  agreementId      String
  companyId        String
  amountCents      Int
  paymentMethod    String
  receivedByRole   String    @default("SELLER")
  receiverUserId   String
  destination      String    @default("SELLER_HANDS")
  paidAt           DateTime  @default(now())
  receiptUrl       String?
  notes            String?
  isReversed       Boolean   @default(false)
  reversedAt       DateTime?
  reversedByUserId String?
  reversalReason   String?
  bankFeeCents     Int       @default(0)
  externalPaymentId String?
  isAsaasSettled   Boolean   @default(false)
  settledAt        DateTime?
  idempotencyKey   String?   @unique
  createdAt        DateTime  @default(now())

  agreement   CreditAgreement           @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  company     Company                   @relation(fields: [companyId], references: [id])
  receiver    User                      @relation("CreditPaymentReceiver", fields: [receiverUserId], references: [id])
  reversedBy  User?                     @relation("CreditPaymentReverser", fields: [reversedByUserId], references: [id])
  allocations CreditPaymentAllocation[]
  commissions CreditCommission[]

  @@index([agreementId])
  @@index([companyId, paidAt])
  @@index([receiverUserId, paidAt])
  @@index([externalPaymentId])
}

model CreditPaymentAllocation {
  id             String @id @default(uuid())
  paymentId      String
  installmentId  String
  allocatedCents Int

  payment     CreditPayment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  installment CreditInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([installmentId])
}

model CreditCommission {
  id             String    @id @default(uuid())
  agreementId    String
  paymentId      String?
  sellerId       String
  companyId      String
  amountCents    Int
  status         String    @default("RELEASED")
  type           String    @default("INSTALLMENT")
  paidAt         DateTime?
  paidByUserId   String?
  costId         String?
  payoutId       String?
  paidMethod     String?
  paidReceiptUrl String?
  paidNotes      String?
  isReversed     Boolean   @default(false)
  reversedAt     DateTime?
  reversalReason String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())

  agreement CreditAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  payment   CreditPayment?  @relation(fields: [paymentId], references: [id])
  seller    User            @relation("CreditCommissionSeller", fields: [sellerId], references: [id])
  company   Company         @relation(fields: [companyId], references: [id])
  monthlyClosingId String?
  monthlyClosing   MonthlyCreditClosing? @relation(fields: [monthlyClosingId], references: [id])

  @@index([sellerId, status])
  @@index([companyId, status])
  @@index([agreementId])
  @@index([payoutId])
  @@index([monthlyClosingId])
}

model CreditAgreementRenegotiation {
  id                     String   @id @default(uuid())
  agreementId            String
  authorId               String
  previousRemainingCents Int
  newRemainingCents      Int
  reason                 String
  previousSchedule       Json
  newSchedule            Json
  idempotencyKey         String?  @unique
  createdAt              DateTime @default(now())

  agreement CreditAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  author    User            @relation("CreditRenegotiationAuthor", fields: [authorId], references: [id])

  @@index([agreementId])
}

model CreditCommissionAdjustment {
  id              String    @id @default(uuid())
  companyId       String
  sellerId        String
  agreementId     String
  paymentId       String?
  commissionId    String?
  amountCents     Int
  reason          String
  status          String    @default("PENDING")
  appliedPayoutId String?
  appliedAt       DateTime?
  idempotencyKey  String?   @unique
  createdAt       DateTime  @default(now())

  company   Company         @relation(fields: [companyId], references: [id])
  seller    User            @relation("CreditCommissionAdjustmentSeller", fields: [sellerId], references: [id])
  agreement CreditAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  monthlyClosingId String?
  monthlyClosing   MonthlyCreditClosing? @relation(fields: [monthlyClosingId], references: [id])

  @@index([sellerId, status])
  @@index([companyId, status])
  @@index([monthlyClosingId])
}

model AsaasConfig {
  id           String   @id @default(uuid())
  companyId    String   @unique
  mode         String   @default("DISABLED")
  apiKey       String?
  webhookToken String?
  walletId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}

model AsaasCharge {
  id                  String    @id @default(uuid())
  companyId           String
  agreementId         String
  installmentId       String    @unique
  externalId          String    @unique
  customerExternalId  String
  billingType         String    @default("UNDEFINED")
  status              String    @default("PENDING")
  nominalValueCents   Int
  netValueCents       Int?
  feeCents            Int?
  dueDate             DateTime
  paymentDate         DateTime?
  clientPaymentDate   DateTime?
  settledAt           DateTime?
  bankSlipUrl         String?
  invoiceUrl          String?
  identificationField String?
  pixQrCodeUrl        String?
  pixPayload          String?
  isManualPaymentSync Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company     Company           @relation(fields: [companyId], references: [id])
  agreement   CreditAgreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  installment CreditInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([agreementId])
  @@index([externalId])
}

model AsaasSyncQueue {
  id             String   @id @default(uuid())
  companyId      String
  agreementId    String
  installmentId  String?
  action         String
  payload        Json
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  maxAttempts    Int      @default(5)
  lastError      String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([agreementId])
}

model AsaasWebhookEvent {
  id                String    @id @default(uuid())
  companyId         String?
  eventId           String?
  event             String
  externalPaymentId String
  payload           Json
  processed         Boolean   @default(false)
  processingError   String?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())

  @@index([externalPaymentId])
  @@index([event])
  @@index([createdAt])
}

model AsaasDuplicatePaymentAlert {
  id                String    @id @default(uuid())
  companyId         String
  agreementId       String
  installmentId     String
  externalPaymentId String
  bankPaymentId     String?
  amountCents       Int
  reason            String
  status            String    @default("PENDING")
  resolvedAt        DateTime?
  resolvedByUserId  String?
  notes             String?
  createdAt         DateTime  @default(now())

  company     Company           @relation(fields: [companyId], references: [id])
  agreement   CreditAgreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  installment CreditInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

model MonthlyCreditClosing {
  id                          String    @id @default(uuid())
  companyId                   String
  sellerId                    String
  competence                  String    // "YYYY-MM", ex: "2026-08"
  status                      String    @default("CLOSED") // "CLOSED", "PARTIALLY_PAID", "PAID"
  
  startDate                   DateTime
  endDate                     DateTime
  
  totalPrincipalReceivedCents Int       @default(0)
  totalCommissionCents        Int       @default(0)
  adjustmentsCents            Int       @default(0)
  netCommissionCents          Int       @default(0)
  paidAmountCents             Int       @default(0)
  remainingBalanceCents       Int       @default(0)
  
  itemsCount                  Int       @default(0)
  calculatedAt                DateTime  @default(now())
  closedByUserId              String?
  notes                       String?
  
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  company                     Company   @relation(fields: [companyId], references: [id])
  seller                      User      @relation("MonthlyClosingSeller", fields: [sellerId], references: [id])
  closedByUser                User?     @relation("MonthlyClosingCloser", fields: [closedByUserId], references: [id])
  payouts                     MonthlyCreditClosingPayout[]
  commissions                 CreditCommission[]
  adjustments                 CreditCommissionAdjustment[]

  @@unique([companyId, sellerId, competence])
  @@index([companyId, competence])
  @@index([sellerId, competence])
  @@index([companyId, status])
}

model MonthlyCreditClosingPayout {
  id              String   @id @default(uuid())
  closingId       String
  amountCents     Int
  paymentMethod   String   @default("PIX")
  receiptUrl      String?
  notes           String?
  authorId        String
  idempotencyKey  String?  @unique
  paidAt          DateTime @default(now())
  createdAt       DateTime @default(now())

  closing         MonthlyCreditClosing @relation(fields: [closingId], references: [id], onDelete: Cascade)
  author          User                 @relation("MonthlyClosingPayoutAuthor", fields: [authorId], references: [id])

  @@index([closingId])
  @@index([authorId])
}

model AccountDeletionRequest {
  id                   String    @id @default(uuid())
  userId               String
  companyId            String?
  status               String    @default("PENDING_REVIEW")
  reason               String?
  scheduledAnonymizeAt DateTime
  processedAt          DateTime?
  processedByUserId    String?
  rejectionReason      String?
  metadata             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user                 User      @relation("UserDeletionRequests", fields: [userId], references: [id], onDelete: Cascade)
  processedBy          User?     @relation("ProcessedDeletionRequests", fields: [processedByUserId], references: [id], onDelete: SetNull)
  company              Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([companyId, status])
  @@index([status, scheduledAnonymizeAt])
}

